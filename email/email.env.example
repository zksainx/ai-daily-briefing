# Keep the real file at ~/.config/ai-daily-briefing/email.env with chmod 600.
BRIEFING_EMAIL_ENABLED=0
BRIEFING_EMAIL_FROM="AI 工业界简报 <briefing@example.com>"
BRIEFING_EMAIL_REPLY_TO=briefing@example.com
BRIEFING_SMTP_HOST=smtp.example.com
BRIEFING_SMTP_PORT=465
BRIEFING_SMTP_SECURITY=ssl
BRIEFING_SMTP_USERNAME=briefing@example.com
# Recommended on macOS: store the password in Keychain under this service.
BRIEFING_SMTP_KEYCHAIN_SERVICE=ai-daily-briefing-smtp
# Cross-platform fallback (less secure than Keychain):
# BRIEFING_SMTP_PASSWORD=replace-with-app-password
